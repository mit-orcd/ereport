# Copy to /etc/ereport/ecrawl-daily.conf and adjust paths.
#
# RSYNC_DEST — Root on another machine (or local path) for crawl output. Each job’s output_dir syncs
#     to DEST/<basename(output_dir)>/ unless basename(DEST) already matches basename(output_dir),
#     in which case files go straight into DEST/ (no doubled folder). Example: RSYNC_DEST=…/crawl,
#     output_dir …/server-a → …/crawl/server-a/. After each successful rsync, shard/manifest
#     files in that output_dir are deleted locally (same names as on failed-run cleanup). Use
#     RSYNC_DEST only when you want sync; every mirrored job needs a non-empty output_dir column.
#
# Syntax:
#   - Lines before ---jobs--- are directives: KEY=value
#   - After ---jobs---, one crawl per line, TAB-separated:
#       start_path — directory ecrawl walks
#       output_dir — where crawl output is written on *this* host (required if you use RSYNC_DEST);
#                    parent dirs are created if missing (mkdir -p); on a failed run known ecrawl
#                    artifact filenames under output_dir may be deleted (see ecrawl-daily.sh header).
#     An empty output_dir still needs the tab (e.g. path<TAB>). A third column is ignored with a
#     warning: ecrawl --record-root was removed — relabel paths at report time with
#     ereport --path-rewrite OLD=NEW.

ECRAWL_BIN=/opt/ereport/ecrawl

RSYNC_DEST=backup.example.com:/var/lib/ereport-crawl/

# Optional: remote shell for rsync (same -e as rsync)
# RSYNC_RSH=ssh -o BatchMode=yes -o StrictHostKeyChecking=accept-new
# RSYNC_DELETE=1

# --- jobs (TAB-separated: start_path, output_dir) ---
---jobs---
/mnt/server-a/data	/var/lib/ecrawl/server-a
/mnt/server-b/home	/var/lib/ecrawl/server-b
